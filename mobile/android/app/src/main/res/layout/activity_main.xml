<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/language_group"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:contentDescription="@string/language_selector"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/language_zh"
                    style="@style/LanguageOption"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:text="@string/language_chinese" />

                <RadioButton
                    android:id="@+id/language_en"
                    style="@style/LanguageOption"
                    android:layout_width="62dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/language_english" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/status_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/connection_indicator"
                android:layout_width="18dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/status_dot"
                android:textColor="@color/inactive"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bluetooth"
                    android:textColor="@color/bluetooth_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connection_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/disconnected"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/scan_button"
                style="@style/ConnectionButton"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:text="@string/scan" />

            <Button
                android:id="@+id/reconnect_button"
                style="@style/ConnectionButton"
                android:layout_width="68dp"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:text="@string/reconnect" />

            <Button
                android:id="@+id/disconnect_button"
                style="@style/ConnectionButton"
                android:layout_width="76dp"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:text="@string/disconnect" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/metric_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    style="@style/MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery" />

                <TextView
                    android:id="@+id/battery_value"
                    style="@style/MetricValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/value_pending" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/metric_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    style="@style/MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/range" />

                <TextView
                    android:id="@+id/range_value"
                    style="@style/MetricValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/value_pending" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/metric_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    style="@style/MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/line_sensors" />

                <TextView
                    android:id="@+id/line_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/value_pending"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/line_left_indicator"
                        android:layout_width="18dp"
                        android:layout_height="6dp"
                        android:background="@drawable/sensor_inactive" />

                    <View
                        android:id="@+id/line_center_indicator"
                        android:layout_width="18dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/sensor_inactive" />

                    <View
                        android:id="@+id/line_right_indicator"
                        android:layout_width="18dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/sensor_inactive" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/command_state"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:text="@string/control_stopped"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/line_mode_group"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:contentDescription="@string/line_mode_selector"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/line_mode_pulse"
                    style="@style/LineModeOption"
                    android:layout_width="58dp"
                    android:layout_height="32dp"
                    android:text="@string/line_mode_pulse" />

                <RadioButton
                    android:id="@+id/line_mode_hybrid"
                    style="@style/LineModeOption"
                    android:layout_width="84dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/line_mode_hybrid" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_limit"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/speed_seek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/speed_limit_accessibility"
                android:progressTint="@color/joystick_throttle"
                android:thumbTint="@color/primary"
                tools:progress="4" />

            <TextView
                android:id="@+id/speed_limit_value"
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:text="@string/value_pending"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <io.github.shengqinchu.sep780.RaceJoystickView
            android:id="@+id/race_joystick"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="260dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/voice_button"
                style="@style/SecondaryAction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/voice_button" />

            <Button
                android:id="@+id/horn_button"
                style="@style/SecondaryAction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/horn_button" />

            <Button
                android:id="@+id/line_button"
                style="@style/PrimaryAction"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/line_follow" />
        </LinearLayout>

        <TextView
            android:id="@+id/transcript_text"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/transcript_empty"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/telemetry_text"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/last_message"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/band"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/stop_button"
            style="@style/DangerAction"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/stop" />
    </LinearLayout>
</LinearLayout>
