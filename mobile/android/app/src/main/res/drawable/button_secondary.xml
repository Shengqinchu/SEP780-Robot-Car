<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/surface" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="@color/divider" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/control_pressed" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="@color/primary" /></shape></item>
    <item><shape><solid android:color="@color/primary_soft" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="@color/primary" /></shape></item>
</selector>
